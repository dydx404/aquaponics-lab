# ─────────────────────────────────────────────────────────────────────
# aquaponics-lab · .env.example
# ─────────────────────────────────────────────────────────────────────
# Copy to .env and edit values before running `docker compose up`.
#   cp .env.example .env
#
# NEVER commit the real .env file — it contains credentials.
# ─────────────────────────────────────────────────────────────────────

# Timezone
TZ=Asia/Shanghai

# ── Ports (change if you have conflicts) ─────────────────────────────
MOSQUITTO_PORT=1883
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
HA_PORT=8123

# ── InfluxDB ─────────────────────────────────────────────────────────
INFLUXDB_DATABASE=aqua
INFLUXDB_USER=aqua
INFLUXDB_PASSWORD=changeme_influx
# Admin — required so init.iql (CREATE DATABASE) runs while HTTP auth is on.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme_admin

# ── Grafana ──────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana

# ── Simulator ────────────────────────────────────────────────────────
SIM_INTERVAL=5
SIM_TIME_SCALE=1.0

# ── Home Assistant (optional: set your own) ─────────────────────────
HA_LATITUDE=23.13
HA_LONGITUDE=113.26
HA_ELEVATION=10
